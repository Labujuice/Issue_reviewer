# Repository Provider Configuration (options: github, gitlab)
REPO_PROVIDER=github

# GitHub Configuration (required if REPO_PROVIDER=github)
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=owner/repo

# GitLab Configuration (required if REPO_PROVIDER=gitlab)
GITLAB_URL=https://gitlab.com
GITLAB_PRIVATE_TOKEN=your_gitlab_personal_access_token_here
GITLAB_PROJECT_ID=your_gitlab_project_id_here

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Webhook Configuration (Optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
